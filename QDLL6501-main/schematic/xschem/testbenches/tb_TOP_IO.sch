C {code.sym} -840 -250 0 0 {name=PHASE_MEASR only_toplevel=true
value="
.options method=gear reltol=1e-1 abstol=1e-1 vntol=1e-1
.control
 tran 20p 40n 20p
* ---- settings you tweak ----


   * ---- user settings ----
  let vlow  = 0
  let vhigh = 1.2
  let v50   = vlow + 0.5*(vhigh - vlow)

  let start_edge = 0     ; skip early edges (settling)
  let N = 1000             ; number of phase samples




  * ---- allocate vectors ----
  let tvec   = vector(N)
  let phivec = vector(N)

  let k = 0
  let i = start_edge

  while k < N
    * crossing times
    meas tran tin      WHEN v(in_a)=v50  RISE=i
    meas tran tout     WHEN v(out_a)=v50 RISE=i
    meas tran tin_next WHEN v(in_a)=v50  RISE=(i+1)

    * delay + period
    let dt = tout - tin
    let T  = tin_next - tin

    * phase in degrees (per-cycle)
    let phi = 360*dt/T
    let phi = phi - 360*floor(phi/360)

    * store sample at time = tin
    let tvec[k]   = tin
    let phivec[k] = phi

    let k = k + 1
    let i = i + 1
  end

  * plot phase vs time (one point per cycle)
  plot phivec vs tvec
  *plot v(vcont) 
  plot v(vin) v(vout) 
  plot v(in_a) v(out_a) 
  plot v(vcont)
  plot v(in_a) v(out)
.endc
"
spice_ignore=true}
